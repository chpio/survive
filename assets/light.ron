// The day-night cycle (see `light::LightValues`). Times of day are in game hours (0–24).
(
    // real seconds per day
    day_length: 600.,
    start: 8.,
    // the night begins and ends in the middle of the dusk and the dawn
    night_start: 21.,
    night_share: 0.3333,
    twilight: 1.5,
    // 0 is black, 1 as bright as by day
    night_brightness: 0.5,
    // in px, at most `sight::MAX_SIGHT_RADIUS` (300)
    day_sight_radius: 200.,
    night_sight_radius: 120.,
    // degrees above the horizon at noon; lower makes longer shadows
    sun_elevation: 50.,
    // how much the shadows darken, 0 not at all, 1 black
    shadow_strength: 0.3,
    // color grading per phase, blended over the day; the dusk's and the dawn's apply in the middle
    // of the twilight. Left out, a value changes nothing: exposure in stops, temperature (+ warmer,
    // − cooler) and tint (+ magenta, − green) of a few hundredths, saturation and contrast 1.
    // Contrast below 1 turns black gray (0.9 already lifts it to 63/255).
    grading: (
        day: (temperature: 0.005),
        dusk: (temperature: 0.03, tint: 0.008, saturation: 1.1),
        night: (temperature: -0.03, saturation: 0.7),
        dawn: (temperature: 0.015, tint: 0.012),
    ),
)
