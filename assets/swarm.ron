// The swarm enemies (see `enemy::swarm::SwarmValues` and `docs/schwarm.md`).
(
    // the player has 100 health
    damage: 4.,
    // relative to the normal speed of enemies (`enemy::MOVE_SPEED`, 100 px/s)
    approach_speed: 1.5,
    circle_speed: 0.6,
    retreat_speed: 1.,
    // in seconds
    approach_timeout: 2.,
    retreat_time: (1., 2.),
    // degrees from the direction of the attack, to either side
    retreat_angle: (90., 150.),
    // px from the player, per enemy
    circle_distance: (30., 40.),
    // how many enemies attack at once
    max_tokens: 2,
)
